{
  "name": "@iridium-group/config",
  "version": "0.1.0",
  "description": "Zero-dependency loading and validation for Iridium configuration files, with environment overrides and a published JSON Schema.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "author": "Iridium Group contributors",
  "homepage": "https://github.com/Iridium-Group/iridium-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Iridium-Group/iridium-config.git"
  },
  "bugs": {
    "url": "https://github.com/Iridium-Group/iridium-config/issues"
  },
  "keywords": [
    "config",
    "configuration",
    "json-schema",
    "validation",
    "environment"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js"
    },
    "./schema.json": "./schema/iridium.schema.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/**/*.test.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2"
  }
}
